# Copy to .env and adjust for the host. The sign-in keys below are left blank
# here on purpose: generate real ones with `python -m auth.manage new-key`.

CLOUD_MQTT_URL=mqtt://localhost:1884

# Starlette's CORSMiddleware matches Origin by exact string, so localhost,
# 127.0.0.1 and [::1] are three distinct origins even on the same machine.
# Opening the UI on any origin not listed here makes the browser's OPTIONS
# preflight return 400 and silently blocks the POST -- commands never reach
# the broker at all. See api/app.py:41-47.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173,http://localhost:5174,http://127.0.0.1:5174,http://[::1]:5174,http://localhost:5175,http://127.0.0.1:5175

# Camera snapshot library: each JPEG plus a JSON sidecar, listed by GET /snapshots
# and re-indexed from this directory on startup. Defaults to data/snapshots under
# this repo (gitignored). Avoid /tmp if you want the library to survive a reboot.
# SNAPSHOTS_DIR=data/snapshots

# Where uploaded and spoken announcement clips are kept. Default:
# roverhub-backend/data/audio-clips (persistent). Missions reference these.
# AUDIO_CLIPS_DIR=

# Mission library: one <mission_id>.json per mission saved from the console's
# Missions workspace. Defaults to data/missions under this repo (gitignored).
# MISSIONS_DIR=data/missions

# Scheduled tasks: tasks/<task_id>.json (robot + schedule + dispatch rule, pointing at a
# mission) and occurrences/ (the dated runs the scheduler materialises). Defaults to
# data/tasks under this repo (gitignored).
# TASKS_DIR=data/tasks

# The background scheduler loop writes occurrences to TASKS_DIR every 30 s. Set to
# false (or 0/no/off) to stop it, e.g. when inspecting data without changing it.
# SCHEDULER_ENABLED=true

# Device acceptance -- INFORMATIONAL, gates nothing (no auth exists to make it a
# control; see robots/registry.py). "auto" (default) accepts every bridge that
# registers, as before. "manual" makes unknown devices arrive as "pending" in
# GET /robots/pending until POST /robots/{id}/accept. The registry is in memory,
# so in manual mode list known robot or bridge ids here or they return to
# "pending" after every backend restart.
# DEVICE_ACCEPTANCE=auto
# ACCEPTED_DEVICES=rover-jetson,rover-pi

# A robot nothing has been heard from (registration, heartbeat or telemetry) for
# this many seconds reads as offline in GET /robots, and runs, Run now and the
# scheduler refuse it until it is heard from again. Default 15 = three of the
# bridge's 5 s heartbeats. Raise it with HEARTBEAT_INTERVAL_S; 0 disables aging.
# ROBOT_OFFLINE_AFTER_S=15

# Mission run folders (run.json, events.jsonl, photos/, video/, audio/,
# detections/). Default: roverhub-backend/data/runs.
# RUNS_DIR=

# Copy each finished run to an S3 or S3-compatible bucket, under
# <site_id>/<run_id>/. Off when unset. Needs `pip install boto3`.
# Credentials: the standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_DEFAULT_REGION variables. Keep the bucket private: runs record people.
# RUNS_BUCKET=
# RUNS_BUCKET_ENDPOINT=   # e.g. https://kr.object.ncloudstorage.com for NAVER Cloud

# --- Sign-in (auth/) -----------------------------------------------------------
# Off unless true. Turn it on together with the broker's sign-in
# (docker-compose.auth.yml in the root repo) and DEVICE_KEYS on both edge devices;
# the order is in docs/superpowers/specs/2026-11-04-sign-in-design.md.
# Before the first sign-in:  python -m auth.manage create-owner <username>
# AUTH_ENABLED=false
#
# Users live in this file (scrypt hashes, never plain passwords). The token-signing
# secret is generated beside it as auth_secret unless AUTH_SECRET is set.
# USERS_FILE=data/users.json
# AUTH_SECRET=
# How long a sign-in lasts, in seconds (default 12 h, one shift).
# AUTH_TOKEN_TTL_S=43200
# Set true when the console is served over HTTPS, so the session cookie is Secure.
# AUTH_COOKIE_SECURE=false
#
# One key per edge bridge, robot_id:key, comma-separated. The bridge sends it as
# CLOUD_API_KEY and uses it as its broker password (username = robot_id).
# DEVICE_KEYS=rover-pi:<key>,rover-jetson:<key>
#
# This service's own broker password (username roverhub-backend). Must match what
# the broker's sign-in hook expects -- it asks this service, so set it here only.
# BROKER_SERVICE_PASSWORD=
